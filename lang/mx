load "lib"define lu(a){	n=length(a)	d=1	vv=#n	do(i, #n){		vv[i] =1/ max(abs(a[i]))	}	do(j, #n){		do(i, 0..j) {			a[i,j] = a[i,j] - sum(a[i, #i] * a[#i, j] )		}		big=0		do(i, j..n) {			a[i,j] = a[i,j] - sum(a[i, #j] * a[#j, j] )			if( vv[i]*abs(a[i,j]) >=big ){				big=vv[i]*abs(a[i,j])				imax = i			}		}		if(j != imax){			{ a[imax], a[j] } = { a[j], a[imax] }			d = -d		}		indx[j] = imax		if(a[i,j]==0.0) a[i,j] = TINY		if( j != n) {			a[( j+1)..n, j] = a[(j+1)..n, j]/a[j.j] 		}	}	return {a, indx}}define lu0(a){}