typedef complexadd(complex x, complex y) = complex(x+y)mul(complex x, complex y) = complex {x[0]*y[0]-x[1]*y[1], x[0]*y[1]+x[1]*y[0]}re(complex(a,b)) = aim(complex(a,b)) = babs(complex(a,b)) = sqr( a^2 +b^2)dp(x,y) = map(z->z y, x)ones(n)=map(x->1, #n)repeat(fn, n, x) = if(n==0) x else fn repeat(fn, n-1, x)gcd(m, n) = if(m==0) n else gcd(mod(n,m), m)define normalize(m,n){	c=gcd(m,n)	{m/c, n/c}}typedef rationaladd(rational p, rational q) = rational normalize(p[0]*q[1]+q[0]*p[1], p[1]*q[1])mul(rational p, rational q) = rational normalize(p[0]*q[0], p[1]*q[1])div(rational p, rational q) = rational normalize(p[0]*q[1], p[1]*q[0])eq(rational p, rational q) = (p[0]==q[0]) & (p[1]==q[1])syntax for((a, b, c) sts){	a	while(b){ 		sts		c	}}syntax do((i, I) st) {	map(i->st, I)	0}filter(fn, I) = merge(map( x-> if( fn(x) ) {{x}} else {{}}, I) )syntax enumerate((i, I) ex) {	merge(map(i->ex, I))}